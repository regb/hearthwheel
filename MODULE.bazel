module(name = "hearthwheel")

# SGL is not on the Bazel Central Registry yet, so pin a commit of
# https://github.com/regb/scala-game-library. To build against a local SGL
# checkout instead, add this line to .bazelrc.user:
#   common --override_module=sgl.bzl=/path/to/scala-game-library
bazel_dep(name = "sgl.bzl", version = "0.0.0", repo_name = "sgl")
git_override(
    module_name = "sgl.bzl",
    commit = "ae53b9e03126694ed80d415026d918910a0b4384",
    remote = "https://github.com/regb/scala-game-library.git",
)

# rules_scala reads the Scala version only from the root module, so it is
# repeated here. It must match the version SGL is built with.
bazel_dep(name = "rules_scala", version = "7.2.6")
bazel_dep(name = "platforms", version = "1.1.0")

# Only for the prebuilt protoc flag in .bazelrc.
bazel_dep(name = "protobuf", version = "33.4")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "3.3.8")

# Toolchains for scala_test (ScalaTest).
scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scalatest()

# The stress tool waits for the GPU with LWJGL, at the version SGL uses.
bazel_dep(name = "rules_jvm_external", version = "7.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = ["org.lwjgl:lwjgl-opengl:3.3.6"],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
